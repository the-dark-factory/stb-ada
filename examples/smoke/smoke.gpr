--  Smoke test for df_stb.
--
--  Builds against the in-tree df_stb library. The STB C implementation
--  is compiled into libstb_ada.a by gprbuild (see df_stb.gpr), so there
--  is nothing extra to link here.

with "../../df_stb.gpr";

project Smoke is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("smoke.adb");

   package Compiler is
      for Default_Switches ("ada") use
        ("-gnatwa", "-gnatVa", "-O0", "-g");
   end Compiler;

end Smoke;
