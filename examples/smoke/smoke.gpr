--  Smoke test for stb-ada.
--
--  Builds against the in-tree stb_ada library + the libstb.a
--  produced by scripts/build-stb.sh. The linker flags propagate
--  from stb_ada.gpr's Linker_Options; nothing extra needed here.

with "../../stb_ada.gpr";

project Smoke is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("smoke.adb");

   package Compiler is
      for Default_Switches ("ada") use
        ("-gnatwa", "-gnatVa", "-O0", "-g");
   end Compiler;

end Smoke;
